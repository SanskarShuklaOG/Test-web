# Local run:  node --env-file=.env server.js   (Node 20.6+)  — on a host, set these as environment variables
ADMIN_PASSWORD=choose-a-long-password
OWNER_WHATSAPP=918376090443
# Option A (free, unofficial, your own number): get a key from callmebot.com
CALLMEBOT_KEY=
# Option B (official Meta WhatsApp Cloud API)
WA_TOKEN=
WA_PHONE_ID=
# Where orders + uploaded photos are stored (use a persistent disk in production)
DATA_DIR=./data
